

# PostgreSQL connection URL
DATABASE_URL=sqlite:///./quant.db
APP_ENV=development
QUARTSYS_COMMUNITY_EDITION=1

# Optional: enable AI assistant endpoint
OPENAI_API_KEY=
# Default model (override per deployment or in the settings page)
LLM_MODEL=deepseek-v4-flash

# JWT/Auth settings
SECRET_KEY=quartsys-dev-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional: run server port
PORT=18427

# Shared cache and durable task queue (required in production)
REDIS_URL=redis://127.0.0.1:16389/0
CELERY_BROKER_URL=redis://127.0.0.1:16389/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:16389/2
QUEUE_ENABLED=0
QUEUE_MAX_PENDING=100
QUEUE_GLOBAL_CONCURRENCY=4
QUEUE_MIN_CONCURRENCY=2
QUEUE_MEMORY_LOW_MB=1400
QUEUE_MEMORY_RECOVER_MB=2400
QUEUE_LOAD_HIGH=6
QUEUE_LOAD_RECOVER=4
QUEUE_SLOT_TTL_SECONDS=1500
QUEUE_TASK_LEASE_TTL_SECONDS=180
QUEUE_TASK_ACTIVE_HEARTBEAT_SECONDS=180
QUEUE_TASK_MAX_ATTEMPTS=3
QUEUE_ADMISSION_RETRY_LIMIT=1000
CELERY_TASK_TIME_LIMIT=10800
CELERY_TASK_SOFT_TIME_LIMIT=10200
CELERY_VISIBILITY_TIMEOUT=14400
CACHE_REQUIRE_REDIS=1
CACHE_ALLOW_MEMORY_FALLBACK=0
CACHE_L1_ENABLED=0
CACHE_MEMORY_MAX_ENTRIES=5000
CACHE_TTL_JITTER_RATIO=0.1
CACHE_COMPRESS_THRESHOLD_BYTES=65536
CACHE_MAX_VALUE_BYTES=5242880
ANALYTICS_API_LOG_BATCH_SIZE=250
CELERY_RESULT_EXPIRES=86400

# Optional legacy bulk updater gateway. Leave empty in the community edition;
# configure a provider owned by your deployment only when you have permission
# to use it.
CF_WORKER_URL=

# API/scheduler process roles. API workers must set this to 0; the scheduler
# service sets it to 1. Celery workers set QUARTSYS_CELERY_WORKER=1.
QUARTSYS_ENABLE_SCHEDULER=0
# Production systemd units run schema migration in a dedicated one-shot unit.
QUARTSYS_RUN_STARTUP_MIGRATIONS=0
WEB_CONCURRENCY=2
CELERY_WORKER_CONCURRENCY=4
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5
# Per-process overrides take precedence over the legacy DB_POOL_SIZE values.
DB_API_POOL_SIZE=3
DB_API_MAX_OVERFLOW=2
DB_WORKER_POOL_SIZE=2
DB_WORKER_MAX_OVERFLOW=1
DB_SCHEDULER_POOL_SIZE=2
DB_SCHEDULER_MAX_OVERFLOW=1
DB_MAINTENANCE_POOL_SIZE=1
DB_MAINTENANCE_MAX_OVERFLOW=1

# Optional: HK/US base security universe for update_real_data.py.
# CSV columns: code,name,industry,area,board,asset_type
QUARTSYS_SECURITY_UNIVERSE_FILE=security_universe.csv
# Inline extra symbols, separated by comma/semicolon/newline:
# code|name|industry|area
QUARTSYS_HK_US_STOCKS=
